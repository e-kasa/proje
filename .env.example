# ═══════════════════════════════════════════════════════════════════
# SEDCORE POS — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env
# .env dosyasını asla git'e commit etmeyin!
# ═══════════════════════════════════════════════════════════════════

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_DB=ekalem
POSTGRES_USER=ekalem
POSTGRES_PASSWORD=DEGISTIR_GUCLU_SIFRE

# ── Spring Datasource (tüm Java servisler) ───────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ekalem
SPRING_DATASOURCE_USERNAME=ekalem
SPRING_DATASOURCE_PASSWORD=DEGISTIR_GUCLU_SIFRE

# ── JWT (min 32 karakter — üretmek için: openssl rand -hex 32) ──
JWT_SECRET=DEGISTIR_EN_AZ_64_KARAKTER_RASTGELE_DEGER

# ── OCR Servisi ──────────────────────────────────────────────────
OCR_SERVICE_URL=http://ocr-service:8003

# ── E-posta (varsayılan: kapalı) ─────────────────────────────────
MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ── SMS / Twilio (varsayılan: noop = devre dışı) ─────────────────
NOTIFICATION_SMS_PROVIDER=noop
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=DEGISTIR_GRAFANA_SIFRESI

# ── GitHub Container Registry ────────────────────────────────────
GHCR_USERNAME=github_kullanici_adi
GHCR_TOKEN=github_pat_tokeni
